# Copy this file to `.env` (inside the `deploy/` directory) before launching:
#   cp example.env .env
# Docker Compose reads these variables. Note: it does NOT expand `~` or run
# `$(...)`, so use literal, absolute values below.

# MongoDB port exposed to the host (host_ip:port)
RECLIC_MONGO_PORT=127.0.0.1:27020
# Backend (Flask) port exposed to the host (host_ip:port)
RECLIC_BACKEND_PORT=127.0.0.1:5000
# Frontend (Caddy) ports exposed to the host
RECLIC_HTTPS_PORT=443
RECLIC_HTTP_PORT=80
# Data directory for MongoDB, backend files and TLS certs.
# Must be an ABSOLUTE path (no `~`).
RECLIC_DATA_DIR=/srv/reclic-data
# Domain served by Caddy. Caddy will request a Let's Encrypt certificate for it,
# so it must be a real, publicly-resolvable domain in production. For local
# testing use `localhost` (Caddy then serves a self-signed cert over HTTPS).
RECLIC_DOMAIN=dev.licenserec.com
# Docker Compose project name (container name prefix). Literal value only.
COMPOSE_PROJECT_NAME=reclic
# Github token used by the backend to clone repositories for analysis.
GITHUB_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
